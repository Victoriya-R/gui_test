  "keywords": [
    "basis",
    "btob"
  ],
  "author": "Alexandre Seryakov",
  "license": "ISC",
  "devDependencies": {
    "cypress": "12.12.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.3.0"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "xml2js": "^0.6.2"
  }
